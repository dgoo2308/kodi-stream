[Unit]
Description=stream.nellika.io sign-in (passkeys, phone pairing for TVs, revocable device sessions)
After=network.target

[Service]
Type=simple
# venv: python3.11 + webauthn + segno (see vps/deploy.sh)
ExecStart=/opt/stream-auth/venv/bin/python /opt/stream-auth/stream-auth.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
