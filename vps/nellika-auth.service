[Unit]
Description=Nellika sign-in (auth.nellika.io: passkeys, invites, phone pairing, per-app sessions)
After=network.target

[Service]
Type=simple
# venv: python3.11 + webauthn + segno (see vps/deploy.sh)
ExecStart=/opt/nellika-auth/venv/bin/python /opt/nellika-auth/nellika-auth.py serve
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
